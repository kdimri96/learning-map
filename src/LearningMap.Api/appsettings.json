{
  // NO SECRETS IN THIS FILE. Passwords/keys go in user-secrets locally (see README),
  // and in Key Vault / pipeline variables in a real deployment.
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=LearningMapDb;Trusted_Connection=True;TrustServerCertificate=True",
    // Well-known Azurite (local emulator) shortcut, not a secret.
    "BlobStorage": "UseDevelopmentStorage=true"
  },
  "JwtSettings": {
    "IssuerSigningKey": "",
    "ValidIssuer": "learning-map-api",
    "ValidAudience": "learning-map-clients",
    "TokenExpirationInMinutes": 60
  },
  "BlobStorageSettings": {
    "ContainerName": "employee-images",
    "SasExpiryMinutes": 60
  },
  "SeedAdmin": {
    "Email": "admin@learningmap.local",
    "FullName": "Learning Map Admin",
    "Password": ""
  },
  // Browser origins allowed to call the API directly (the React dev server is on 5173).
  "AllowedOrigins": [ "http://localhost:5173", "http://localhost:3000" ],
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": { "path": "logs/learning-map-.log", "rollingInterval": "Day", "retainedFileCountLimit": 7 }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*"
}
